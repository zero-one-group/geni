#!/usr/bin/env bash

# Downloads the Geni REPL uberjar of the latest stable release, and runs it.
# The install script is inspired by borkdude's clj-kondo:
# https://github.com/borkdude/clj-kondo

set -euo pipefail

print_help() {
    echo "Runs the Geni REPL and starts an nREPL server with an .nrepl-port file."
    echo -e
    echo "Downloads the uberjar of the latest stable release to"
    echo "~/.geni/geni-repl-uberjar-<version>.jar the first time it's needed."
    echo "Without a network, runs the uberjar downloaded last time."
    echo -e
    echo "Usage:"
    echo "geni [--force-download] [--submit script.clj]"
    exit 1
}

script_path=false
force_download=false
while [[ $# -gt 0 ]]
do
    key="$1"
    case $key in
        --submit)
            script_path="$2"
            shift
            shift
            ;;
        --force-download)
            force_download=true
            shift
            ;;
        --help)
            print_help
            shift
            ;;
        *)
            echo "Unrecognised option!"
            echo -e
            print_help
            exit 1
    esac
done

original_dir="$PWD"
download_dir="$HOME/.geni/downloads"
uberjar_dir="$HOME/.geni"
version_url="https://raw.githubusercontent.com/zero-one-group/geni/develop/resources/GENI_REPL_RELEASED_VERSION"

mkdir -p "$uberjar_dir"
cd "$uberjar_dir"
if version=$(curl -fsSL "$version_url"); then
    download_url="https://github.com/zero-one-group/geni/releases/download/v$version/geni-repl-uberjar-$version.jar"
    # One file per version, so that a new release gets downloaded.
    uberjar_name="geni-repl-uberjar-$version.jar"
else
    # Offline, or GitHub didn't answer: run the uberjar downloaded last time.
    uberjar_name=$(ls -t geni-repl-uberjar-*.jar 2>/dev/null | head -n 1 || true)
    if [[ -z "$uberjar_name" ]] || [[ "$force_download" = true ]]; then
        echo "Couldn't fetch the latest version from $version_url"
        exit 1
    fi
    echo "Couldn't fetch the latest version, so running $uberjar_name."
fi

if [[ ! -f "$uberjar_name" ]] || [[ "$force_download" = true ]]; then
    mkdir -p "$download_dir"
    cd "$download_dir"
    echo -e "Downloading $download_url to $download_dir ..."
    curl -fL -o "$uberjar_name" "$download_url"
    echo "Moving $download_dir/$uberjar_name to $uberjar_dir/$uberjar_name"
    mv -f "$uberjar_name" "$uberjar_dir/$uberjar_name"
    echo "Successfully downloaded Geni REPL uberjar in $uberjar_dir/$uberjar_name"
    # The uberjars of older versions, including the unversioned one that
    # scripts before 0.1.0 downloaded.
    find "$uberjar_dir" -maxdepth 1 -name 'geni-repl-uberjar*.jar' ! -name "$uberjar_name" -delete
fi

fail_message() {
    echo "Failed running uberjar, try running with --force-download flag."
    exit 1
}

cd "$original_dir"
if [[ "$script_path" = false ]]; then
    java -jar "$uberjar_dir/$uberjar_name" || fail_message
else
    java -jar "$uberjar_dir/$uberjar_name" "$script_path" || fail_message
fi
