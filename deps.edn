{:paths ["src/clojure" "resources" "target/classes"]

 ;; Spark is a provided dependency, so Clojure is the only runtime dep.
 :deps
 {org.clojure/clojure {:mvn/version "1.11.4"}}

 ;; Lets git-dep users build the Java sources with `clojure -X:deps prep`.
 :deps/prep-lib {:alias  :build
                 :fn     compile-java
                 :ensure "target/classes"}

 :aliases
 {;; Spark, which library users bring themselves.
  :spark
  {:extra-deps
   {org.apache.spark/spark-avro_2.12  {:mvn/version "3.5.9"}
    org.apache.spark/spark-mllib_2.12 {:mvn/version "3.5.9"}
    org.apache.spark/spark-sql_2.12   {:mvn/version "3.5.9"}
    ;; Spark 3.5 ships Arrow 12, which can't allocate buffers on JDK 21+.
    org.apache.arrow/arrow-vector       {:mvn/version "13.0.0"}
    org.apache.arrow/arrow-memory-netty {:mvn/version "13.0.0"}}
   ;; The JDK module flags Spark itself uses (org.apache.spark.launcher.JavaModuleOptions).
   :jvm-opts
   ["-XX:+IgnoreUnrecognizedVMOptions"
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED"
    "--add-opens=java.base/java.io=ALL-UNNAMED"
    "--add-opens=java.base/java.net=ALL-UNNAMED"
    "--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--add-opens=java.base/java.util=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED"
    "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.cs=ALL-UNNAMED"
    "--add-opens=java.base/sun.security.action=ALL-UNNAMED"
    "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED"
    "--add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED"
    "-Djdk.reflect.useDirectMethodHandle=false"]}

  ;; clojure -X:spark:test (see CONTRIBUTING.md)
  :test
  {:extra-paths   ["test" "dev" "target/test-classes"]
   :extra-deps    {org.xerial/sqlite-jdbc {:mvn/version "3.53.2.0"}
                   zero.one/fxl           {:mvn/version "0.0.6"}}
   :override-deps {org.clojure/clojure {:mvn/version "1.12.6"}}
   ;; Spark reads spark.* system properties as defaults. With code generation
   ;; off, the tests' many small queries run about 15% faster.
   :jvm-opts      ["-Duser.country=US"
                   "-Duser.language=en"
                   "-Dspark.driver.bindAddress=127.0.0.1"
                   "-Dspark.driver.host=127.0.0.1"
                   "-Dspark.sql.codegen.wholeStage=false"
                   "-Dspark.sql.codegen.factoryMode=NO_CODEGEN"
                   "-Dspark.ui.enabled=false"]
   :exec-fn       zero-one.geni.test-runner/run}

  ;; The Geni CLI (an nREPL server plus a REPL-y prompt) and its tests.
  :cli
  {:extra-paths ["cli/src" "cli/test"]
   :extra-deps  {net.cgrand/parsley {:mvn/version "0.9.3"}
                 nrepl/nrepl        {:mvn/version "0.8.3"}
                 reply/reply        {:mvn/version "0.5.1"
                                     :exclusions  [javax.servlet/servlet-api]}}}

  ;; The tech.ml.dataset interop tests.
  :tmd
  {:extra-paths ["test-tmd"]
   :extra-deps  {techascent/tech.ml.dataset {:mvn/version "6.101"
                                             :exclusions  [ch.qos.logback/logback-classic]}}}

  ;; The XGBoost tests. XGBoost 1.2 fails to train on Apple Silicon, which
  ;; also stops the SparkContext.
  :xgb
  {:extra-paths ["test-xgb"]
   :extra-deps  {ml.dmlc/xgboost4j-spark_2.12 {:mvn/version "1.2.0"}
                 ml.dmlc/xgboost4j_2.12       {:mvn/version "1.2.0"}}}

  ;; For scripts/scrape-spark-docs.clj, which writes resources/spark-docs.edn.
  :scrape
  {:extra-deps {enlive/enlive {:mvn/version "1.1.6"}}}

  ;; clojure -T:build prep | jar | install | deploy
  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                slipset/deps-deploy           {:mvn/version "0.2.5"}}
   :jvm-opts   ["-Dslf4j.internal.verbosity=WARN"]
   :ns-default build}

  :kondo
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts    ["-m" "clj-kondo.main"]}

  :fmt
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
   :main-opts    ["-m" "cljfmt.main"]}}}
