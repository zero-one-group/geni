{:paths ["src/clojure" "resources" "target/classes"]

 ;; Spark is a provided dependency, so Clojure is the only runtime dep.
 :deps
 {org.clojure/clojure {:mvn/version "1.11.4"}}

 ;; Lets git-dep users build the Java sources with `clojure -X:deps prep`.
 :deps/prep-lib {:alias  :build
                 :fn     compile-java
                 :ensure "target/classes"}

 :aliases
 {;; Spark 3.5 on Scala 2.12, which library users bring themselves. The CLI
  ;; depends on it. Use :spark-3.5-2.13 or :spark-4 in its place for the other
  ;; Spark builds that Geni supports.
  :spark
  {:extra-deps
   {org.apache.spark/spark-avro_2.12  {:mvn/version "3.5.9"}
    org.apache.spark/spark-mllib_2.12 {:mvn/version "3.5.9"}
    org.apache.spark/spark-sql_2.12   {:mvn/version "3.5.9"}
    ;; Spark 3.5 ships Arrow 12, which can't allocate buffers on JDK 21+.
    org.apache.arrow/arrow-vector       {:mvn/version "13.0.0"}
    org.apache.arrow/arrow-memory-netty {:mvn/version "13.0.0"}}
   ;; The JDK module flags Spark itself uses (org.apache.spark.launcher.JavaModuleOptions).
   :jvm-opts
   ["-XX:+IgnoreUnrecognizedVMOptions"
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED"
    "--add-opens=java.base/java.io=ALL-UNNAMED"
    "--add-opens=java.base/java.net=ALL-UNNAMED"
    "--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--add-opens=java.base/java.util=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED"
    "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.cs=ALL-UNNAMED"
    "--add-opens=java.base/sun.security.action=ALL-UNNAMED"
    "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED"
    "--add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED"
    "-Djdk.reflect.useDirectMethodHandle=false"]}

  ;; The same Spark, on Scala 2.13.
  :spark-3.5-2.13
  {:extra-deps
   {org.apache.spark/spark-avro_2.13  {:mvn/version "3.5.9"}
    org.apache.spark/spark-mllib_2.13 {:mvn/version "3.5.9"}
    org.apache.spark/spark-sql_2.13   {:mvn/version "3.5.9"}
    org.apache.arrow/arrow-vector       {:mvn/version "13.0.0"}
    org.apache.arrow/arrow-memory-netty {:mvn/version "13.0.0"}}
   :jvm-opts
   ["-XX:+IgnoreUnrecognizedVMOptions"
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED"
    "--add-opens=java.base/java.io=ALL-UNNAMED"
    "--add-opens=java.base/java.net=ALL-UNNAMED"
    "--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--add-opens=java.base/java.util=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED"
    "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.cs=ALL-UNNAMED"
    "--add-opens=java.base/sun.security.action=ALL-UNNAMED"
    "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED"
    "--add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED"
    "-Djdk.reflect.useDirectMethodHandle=false"]}

  ;; Spark 4, on Scala 2.13, with the flags from its own JavaModuleOptions.
  :spark-4
  {:extra-deps
   {org.apache.spark/spark-avro_2.13     {:mvn/version "4.2.0"}
    ;; Listed so that it comes before datasketches-memory on the classpath:
    ;; its copy of datasketches' JDK check takes JDK 25, and the original
    ;; doesn't, so Spark's sketch functions fail on JDK 25 without it.
    org.apache.spark/spark-catalyst_2.13 {:mvn/version "4.2.0"}
    org.apache.spark/spark-mllib_2.13    {:mvn/version "4.2.0"}
    org.apache.spark/spark-sql_2.13      {:mvn/version "4.2.0"}}
   :jvm-opts
   ["-XX:+IgnoreUnrecognizedVMOptions"
    "--add-modules=jdk.incubator.vector"
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED"
    "--add-opens=java.base/java.io=ALL-UNNAMED"
    "--add-opens=java.base/java.net=ALL-UNNAMED"
    "--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--add-opens=java.base/java.util=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED"
    "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.cs=ALL-UNNAMED"
    "--add-opens=java.base/sun.security.action=ALL-UNNAMED"
    "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED"
    "--add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED"
    "-Dio.netty.tryReflectionSetAccessible=true"
    "-Dio.netty.allocator.type=pooled"
    "-Dio.netty.handler.ssl.defaultEndpointVerificationAlgorithm=NONE"
    "--sun-misc-unsafe-memory-access=allow"
    "--enable-native-access=ALL-UNNAMED"]}

  ;; Spark 4's Spark Connect client, in place of classic Spark, for the tests
  ;; that run over Spark Connect: clojure -T:build connect-tests. The client
  ;; can't share a classpath with spark-sql.
  :spark-connect
  {:extra-deps {org.apache.spark/spark-connect-client-jvm_2.13 {:mvn/version "4.2.0"}}
   ;; The same flags as :spark-4. Arrow, which the client shades, and Spark's
   ;; date and time conversions reach into the JDK.
   :jvm-opts
   ["-XX:+IgnoreUnrecognizedVMOptions"
    "--add-modules=jdk.incubator.vector"
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED"
    "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED"
    "--add-opens=java.base/java.io=ALL-UNNAMED"
    "--add-opens=java.base/java.net=ALL-UNNAMED"
    "--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--add-opens=java.base/java.util=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED"
    "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED"
    "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
    "--add-opens=java.base/sun.nio.cs=ALL-UNNAMED"
    "--add-opens=java.base/sun.security.action=ALL-UNNAMED"
    "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED"
    "--add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED"
    "-Dio.netty.tryReflectionSetAccessible=true"
    "-Dio.netty.allocator.type=pooled"
    "-Dio.netty.handler.ssl.defaultEndpointVerificationAlgorithm=NONE"
    "--sun-misc-unsafe-memory-access=allow"
    "--enable-native-access=ALL-UNNAMED"]}

  ;; The Spark Connect server that those tests run against, with :spark-4.
  :connect-server
  {:extra-deps {org.apache.spark/spark-connect_2.13 {:mvn/version "4.2.0"}}}

  ;; clojure -X:spark:test (see CONTRIBUTING.md)
  :test
  {:extra-paths   ["test" "dev" "target/test-classes"]
   :extra-deps    {org.xerial/sqlite-jdbc {:mvn/version "3.53.2.0"}
                   zero.one/fxl           {:mvn/version "0.0.6"}}
   :override-deps {org.clojure/clojure {:mvn/version "1.12.6"}}
   ;; Spark reads spark.* system properties as defaults. With code generation
   ;; off, the tests' many small queries run about 15% faster.
   :jvm-opts      ["-Duser.country=US"
                   "-Duser.language=en"
                   "-Dspark.driver.bindAddress=127.0.0.1"
                   "-Dspark.driver.host=127.0.0.1"
                   "-Dspark.sql.codegen.wholeStage=false"
                   "-Dspark.sql.codegen.factoryMode=NO_CODEGEN"
                   "-Dspark.ui.enabled=false"]
   :exec-fn       zero-one.geni.test-runner/run}

  ;; The weekly canary (.github/workflows/weekly.yml): the suite with Spark's
  ;; own defaults, code generation included. It goes after :test, so that its
  ;; JVM options win: clojure -X:spark:test:canary
  :canary
  {:jvm-opts ["-Dspark.sql.codegen.wholeStage=true"
              "-Dspark.sql.codegen.factoryMode=FALLBACK"]}

  ;; The doc tests (see CONTRIBUTING.md). test-doc-blocks turns the Clojure
  ;; blocks in the README and docs/ into tests under target/test-doc-blocks,
  ;; and :doc-tests runs them after :spark:test. clojure -T:build docs does both.
  :gen-doc-tests
  {:extra-paths ["dev"]
   :replace-deps {com.github.lread/test-doc-blocks {:mvn/version "1.2.21"}}
   :exec-fn      zero-one.geni.doc-tests/generate
   :exec-args    {:docs     ["README.md" "docs/*.md"]
                  :platform :clj}}

  ;; With Spark's own defaults, code generation included, and two cores, so
  ;; that the outputs in the docs don't depend on the machine's core count.
  :doc-tests
  {:extra-paths ["target/test-doc-blocks/test"]
   :jvm-opts    ["-Dspark.master=local[2]"
                 "-Duser.timezone=UTC"
                 "-Dspark.sql.codegen.wholeStage=true"
                 "-Dspark.sql.codegen.factoryMode=FALLBACK"]
   :exec-args   {:dirs ["target/test-doc-blocks/test"]}}

  ;; The same for the cookbook, which downloads its datasets into
  ;; data/cookbook: clojure -T:build cookbook. Part 13 needs Spark NLP, for
  ;; :spark's Scala 2.12, and downloads its model into ~/cache_pretrained.
  :cookbook
  {:extra-paths ["target/cookbook/test-doc-blocks/test"]
   :extra-deps  {com.johnsnowlabs.nlp/spark-nlp_2.12 {:mvn/version "7.0.0"}}
   :jvm-opts    ["-Dspark.master=local[2]"
                 "-Duser.timezone=UTC"
                 "-Dspark.sql.codegen.wholeStage=true"
                 "-Dspark.sql.codegen.factoryMode=FALLBACK"]
   :exec-args   {:dirs ["target/cookbook/test-doc-blocks/test"]}}

  ;; The Spark Connect guide, run the same way over Spark Connect:
  ;; clojure -T:build connect-tests.
  :connect-docs
  {:extra-paths ["target/connect-docs/test-doc-blocks/test"]
   :exec-args   {:dirs ["target/connect-docs/test-doc-blocks/test"]}}

  ;; The Geni CLI (an nREPL server plus a REPL-y prompt) and its tests. build.clj
  ;; builds the uberjar from cli/src, with these deps and :spark's.
  :cli
  {:extra-paths ["cli/src" "cli/test"]
   :extra-deps  {net.cgrand/parsley {:mvn/version "0.9.3"}
                 nrepl/nrepl        {:mvn/version "0.8.3"}
                 reply/reply        {:mvn/version "0.5.1"
                                     :exclusions  [javax.servlet/servlet-api]}}}

  ;; The tech.ml.dataset tests: g/to-tmd and the other result functions, and
  ;; collect-to-arrow's files read back with tech.ml.dataset's Arrow reader,
  ;; which needs jarrow.
  :tmd
  {:extra-paths ["test-tmd"]
   :extra-deps  {techascent/tech.ml.dataset {:mvn/version "8.026"}
                 com.cnuernber/jarrow       {:mvn/version "1.000"}}}

  ;; Apache Arrow for :spark-connect, whose client only has it shaded. g/to-tmd
  ;; and the other result functions decode Arrow batches with it, and
  ;; clojure -T:build connect-tests runs test-tmd/ with it.
  :connect-arrow
  {:extra-deps {org.apache.arrow/arrow-vector       {:mvn/version "19.0.0"}
                org.apache.arrow/arrow-memory-netty {:mvn/version "19.0.0"}}}

  ;; The XGBoost tests, with XGBoost4J-Spark 3, whose jar includes XGBoost4J:
  ;; :xgb for :spark, and :xgb-2.13 for the Spark builds on Scala 2.13.
  ;; clojure -T:build xgb-tests runs them.
  :xgb
  {:extra-paths ["test-xgb"]
   :extra-deps  {ml.dmlc/xgboost4j-spark_2.12 {:mvn/version "3.4.0"}}}
  :xgb-2.13
  {:extra-paths ["test-xgb"]
   :extra-deps  {ml.dmlc/xgboost4j-spark_2.13 {:mvn/version "3.4.0"}}}

  ;; The XGBoost guide's examples, run as the doc tests are, after :xgb.
  :xgb-docs
  {:extra-paths ["target/xgb-docs/test-doc-blocks/test"]
   :jvm-opts    ["-Dspark.master=local[2]"
                 "-Duser.timezone=UTC"
                 "-Dspark.sql.codegen.wholeStage=true"
                 "-Dspark.sql.codegen.factoryMode=FALLBACK"]
   :exec-args   {:dirs ["target/xgb-docs/test-doc-blocks/test"]}}

  ;; GraphFrames, for zero-one.geni.graph, and its tests in test-graph/:
  ;; :graphframes for :spark, and :graphframes-4 for :spark-4.
  ;; clojure -T:build graph-tests runs them.
  :graphframes
  {:extra-paths ["test-graph"]
   :extra-deps  {io.graphframes/graphframes-spark3_2.12 {:mvn/version "0.12.3"}}}
  :graphframes-4
  {:extra-paths ["test-graph"]
   :extra-deps  {io.graphframes/graphframes-spark4_2.13 {:mvn/version "0.12.3"}}}

  ;; The graphs guide's examples, run as the doc tests are, after :graphframes.
  :graph-docs
  {:extra-paths ["target/graph-docs/test-doc-blocks/test"]
   :jvm-opts    ["-Dspark.master=local[2]"
                 "-Duser.timezone=UTC"
                 "-Dspark.sql.codegen.wholeStage=true"
                 "-Dspark.sql.codegen.factoryMode=FALLBACK"]
   :exec-args   {:dirs ["target/graph-docs/test-doc-blocks/test"]}}

  ;; For scripts/scrape-spark-docs.clj, which writes resources/spark-docs.edn.
  :scrape
  {:extra-deps {enlive/enlive {:mvn/version "1.1.6"}}}

  ;; clojure -T:build prep | jar | install | deploy
  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                slipset/deps-deploy           {:mvn/version "0.2.5"}}
   :jvm-opts   ["-Dslf4j.internal.verbosity=WARN"]
   :ns-default build}

  :kondo
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts    ["-m" "clj-kondo.main"]}

  :fmt
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
   :main-opts    ["-m" "cljfmt.main"]}}}
